{
  "id": "com.swiftpwa.critterfacts",
  "name": "CritterFacts",
  "version": "0.1.0",
  "description": "A swift-pwa demo of the on-device llama.cpp backend: tap a critter and a local LLM streams back a (plausibly true) fun fact — no network after the one-time model download.",
  "agent": {
    "expose": [
      {
        "command": "critter.list",
        "description": "The critters this app knows facts about.",
        "read_only": true,
        "idempotent": true
      },
      {
        "command": "critter.fact",
        "description": "One surprising fact about a critter, written by the on-device model.",
        "read_only": true
      }
    ]
  },
  "web": {
    "directory": "Sources/CritterFacts/web",
    "entry": "index.html"
  },
  "ai": {
    "local_llama": true,
    "gemini_nano": true,
    "phi_silica": true,
    "local_onnx_runtime": true
  },
  "window": {
    "title": "Critter Facts",
    "width": 720,
    "height": 720,
    "resizable": true,
    "fullscreen": false,
    "background_color": { "light": "#f4f6f9", "dark": "#0e1116" }
  },
  "macos": {
    "bundle_identifier": "com.swiftpwa.critterfacts",
    "minimum_system_version": "15.0",
    "copyright": "© 2026 swift-pwa contributors"
  },
  "ios": {
    "bundle_identifier": "com.swiftpwa.critterfacts",
    "minimum_system_version": "18.0"
  },
  "linux": {
    "desktop_categories": [
      "Education"
    ]
  },
  "android": {
    "package_id": "com.swiftpwa.critterfacts",
    "min_sdk": 28,
    "target_sdk": 34,
    "abis": ["arm64-v8a"],
    "version_code": 1,
    "network": {
      "cleartext_domains": ["*.local", "comfyui.local"]
    }
  }
}
