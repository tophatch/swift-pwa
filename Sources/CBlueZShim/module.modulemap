module CBlueZShim [system] {
    header "shim.h"
    // BlueZ's interface *is* D-Bus — there's no usable C library for GATT —
    // so this needs GDBus (gio-2.0) and nothing else: no BlueZ development
    // package, and no GTK. That's why one copy serves both the GTK3 and GTK4
    // backends, unlike the tray shims which are tied to a toolkit version.
    link "gio-2.0"
    link "gobject-2.0"
    link "glib-2.0"
    export *
}
