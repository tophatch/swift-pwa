module CStatusNotifierShim [system] {
    header "shim.h"
    // GDBus (SNI + com.canonical.dbusmenu) + GdkPixbuf for icon loading.
    // GdkPixbuf must be linked explicitly: even though libgtk-4 pulls it
    // in transitively at runtime, `ld --as-needed` won't resolve *our*
    // gdk_pixbuf_* symbols through libgtk-4's own DT_NEEDED chain.
    link "gio-2.0"
    link "gobject-2.0"
    link "glib-2.0"
    link "gdk_pixbuf-2.0"
    export *
}
